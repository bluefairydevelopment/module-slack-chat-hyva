(function () {
    'use strict';

    var TOKEN_PATTERN = /^[a-f0-9]{64}$/;
    var SESSION_GONE = [401, 410];
    var INVALID_TOKEN = 'bfslc_invalid_token';
    var REFUSAL_LABEL = {
        bfslc_upload_limit: 'uploadLimit',
        bfslc_upload_quota: 'uploadQuota',
        bfslc_storage_full: 'storageFull'
    };
    var STATUS_LABEL = { 401: 'ended', 410: 'ended', 403: 'uploadsOff', 413: 'tooLarge', 429: 'rateLimited' };
    var FINAL_REFUSALS = ['bfslc_upload_limit', 'bfslc_file_too_large', 'bfslc_bad_mime', 'bfslc_file_empty'];
    var OWN_ERROR_CODE = /^bfslc_[a-z_]+$/;
    var MAX_RETRY_AFTER_S = 86400;
    var POLL_MS = 3000;
    var SLOW_POLL_MS = 30000;
    var IDLE_POLL_MS = 60000;
    var STATUS_EVERY_N_POLLS = 10;
    var STREAM_RETRY_MS = 60000;
    var STREAM_HEALTHY_MS = 10000;
    var SETTLE_INTERVAL_MS = 30000;
    var SETTLE_WINDOW_MS = 60 * 60000;
    var HISTORY_PAGE = 200;
    var HISTORY_MAX_PAGES = 10;

    var ROW_CLASS = {
        outbound: 'flex flex-col items-end',
        inbound: 'flex flex-col items-start',
        system: 'flex flex-col items-center'
    };
    var BUBBLE_CLASS = {
        outbound: 'max-w-[85%] rounded-lg px-3 py-2 bg-gray-900 text-white',
        inbound: 'max-w-[85%] rounded-lg px-3 py-2 bg-gray-100 text-gray-900',
        system: 'max-w-full rounded px-3 py-1 bg-amber-50 text-amber-900 text-center'
    };
    var BANNER_CLASS = {
        online: 'px-4 py-2 text-sm bg-green-50 text-green-800',
        away: 'px-4 py-2 text-sm bg-amber-50 text-amber-900',
        offline: 'px-4 py-2 text-sm bg-gray-100 text-gray-700'
    };
    var STATUS_FAILED_CLASS = 'mt-1 text-xs text-red-700';
    var STATUS_QUIET_CLASS = 'mt-1 text-xs text-gray-500';

    function readStored(key) {
        try {
            var value = window.localStorage.getItem(key);
            return typeof value === 'string' && TOKEN_PATTERN.test(value) ? value : '';
        } catch (e) {
            return '';
        }
    }

    function writeStored(key, value) {
        try {
            window.localStorage.setItem(key, value);
        } catch (e) {
            return;
        }
    }

    function forgetStored(key, token) {
        try {
            if (token !== '' && window.localStorage.getItem(key) === token) {
                window.localStorage.removeItem(key);
            }
        } catch (e) {
            return;
        }
    }

    function toInt(value) {
        var n = parseInt(value, 10);
        return isNaN(n) ? 0 : n;
    }

    function text(value) {
        return value === null || value === undefined ? '' : String(value);
    }

    function errorCode(data) {
        return data && data.parameters && typeof data.parameters.error_code === 'string'
            ? data.parameters.error_code
            : '';
    }

    function errorMessage(data, fallback) {
        if (!data || typeof data.message !== 'string' || data.message === '') {
            return fallback;
        }
        var params = data.parameters;
        return data.message.replace(/%(\d+)/g, function (match, index) {
            var value;
            if (Array.isArray(params)) {
                value = params[Number(index) - 1];
            } else if (params && typeof params === 'object') {
                value = params[index];
            }
            return value === undefined || value === null ? match : String(value);
        });
    }

    function refusalText(res, i18n) {
        var status = res ? res.status : 0;
        var data = res ? res.data : null;
        var code = errorCode(data);
        function label(key) {
            return Object.prototype.hasOwnProperty.call(i18n, key) ? text(i18n[key]) : '';
        }
        if (Object.prototype.hasOwnProperty.call(REFUSAL_LABEL, code) && label(REFUSAL_LABEL[code]) !== '') {
            return label(REFUSAL_LABEL[code]);
        }
        if (!(status > 0)) {
            return label('networkError') || label('genericError');
        }
        if (status >= 500) {
            return (status === 503 && label('unavailable')) || label('genericError');
        }
        var fallback = label(STATUS_LABEL[status] || 'genericError') || label('genericError');
        if (status >= 400 && OWN_ERROR_CODE.test(code)) {
            return errorMessage(data, fallback);
        }
        return fallback;
    }

    function retryAfterSeconds(value, now) {
        var raw = text(value).trim();
        var seconds = 0;
        if (/^\d+$/.test(raw)) {
            seconds = parseInt(raw, 10);
        } else if (raw !== '') {
            var date = Date.parse(raw);
            seconds = isNaN(date) ? 0 : Math.ceil((date - now) / 1000);
        }
        return Math.max(0, Math.min(MAX_RETRY_AFTER_S, seconds));
    }

    function isGone(res) {
        if (SESSION_GONE.indexOf(res.status) !== -1) {
            return true;
        }
        return res.status === 400 && errorCode(res.data) === INVALID_TOKEN;
    }

    function parseUrl(url) {
        try {
            return new URL(url, window.location.href);
        } catch (e) {
            return null;
        }
    }

    function isAllowedAttachmentUrl(url, allowedOrigins) {
        if (typeof url !== 'string' || url === '') {
            return false;
        }
        var parsed = parseUrl(url);
        if (parsed === null || (parsed.protocol !== 'https:' && parsed.protocol !== 'http:')) {
            return false;
        }
        return allowedOrigins.indexOf(parsed.origin) !== -1;
    }

    function pageUrl() {
        return window.location.origin + window.location.pathname;
    }

    function request(method, url, payload) {
        var init = {
            method: method,
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
        };
        if (payload !== null) {
            init.headers['Content-Type'] = 'application/json';
            init.body = JSON.stringify(payload);
        }
        return window.fetch(url, init).then(function (response) {
            var header = null;
            try {
                header = response.headers && typeof response.headers.get === 'function'
                    ? response.headers.get('Retry-After') : null;
            } catch (e) {
                header = null;
            }
            return response.text().then(function (raw) {
                var data = null;
                try {
                    data = raw === '' ? null : JSON.parse(raw);
                } catch (e) {
                    data = null;
                }
                return {
                    ok: response.ok,
                    status: response.status,
                    data: data,
                    retryAfter: retryAfterSeconds(header, Date.now())
                };
            });
        }, function () {
            return { ok: false, status: 0, data: null, retryAfter: 0 };
        });
    }

    function readAsBase64(file) {
        return new Promise(function (resolve, reject) {
            var reader = new FileReader();
            reader.onload = function () {
                var result = String(reader.result);
                var comma = result.indexOf(',');
                resolve(comma === -1 ? '' : result.slice(comma + 1));
            };
            reader.onerror = function () {
                reject(new Error('read'));
            };
            reader.readAsDataURL(file);
        });
    }

    function bfslcChat() {
        var rt = {
            config: {},
            i18n: {},
            restRoot: '',
            origins: [],
            storageKey: 'bfslc_token_default',
            seq: 0,
            lastId: 0,
            seen: {},
            files: {},
            chain: Promise.resolve(),
            starting: null,
            historyToken: '',
            es: null,
            pollTimer: null,
            pollMs: 0,
            pollBusy: false,
            pollCount: 0,
            retryTimer: null,
            streamEnd: '',
            wasIdle: false,
            unsettled: {},
            settleTimer: null,
            blobUrls: []
        };

        function t(key) {
            return text(rt.i18n[key]);
        }

        return {
            isOpen: false,
            booted: false,
            token: '',
            sessionStatus: '',
            availability: '',
            availabilityMessage: '',
            messages: [],
            notice: '',
            draft: '',
            displayName: '',
            email: '',
            unreadCount: 0,
            uploadsEnabled: false,
            acceptList: '',
            historyLoading: false,

            init() {
                var parsed = {};
                try {
                    parsed = JSON.parse(this.$el.dataset.bfslcConfig || '{}') || {};
                } catch (e) {
                    parsed = {};
                }
                rt.config = parsed;
                rt.i18n = parsed.i18n || {};
                rt.storageKey = 'bfslc_token_' + text(parsed.storeCode || 'default');
                rt.restRoot = text(parsed.restRoot);
                if (rt.restRoot !== '' && rt.restRoot.charAt(rt.restRoot.length - 1) !== '/') {
                    rt.restRoot += '/';
                }
                var restUrl = parseUrl(rt.restRoot);
                rt.origins = [window.location.origin];
                if (restUrl !== null && restUrl.origin !== window.location.origin) {
                    rt.origins.push(restUrl.origin);
                }
                this.uploadsEnabled = parsed.uploadsEnabled === true;
                this.acceptList = (parsed.allowedMimeTypes || []).join(',');

                var self = this;
                window.addEventListener('pagehide', function () {
                    self.stopRealtime();
                    rt.blobUrls.forEach(function (url) {
                        URL.revokeObjectURL(url);
                    });
                    rt.blobUrls = [];
                });
                window.addEventListener('pageshow', function (event) {
                    if (event.persisted) {
                        self.syncRealtime();
                    }
                });
                document.addEventListener('visibilitychange', function () {
                    if (!document.hidden) {
                        self.wake();
                    }
                    self.syncRealtime();
                });
            },

            get ariaExpanded() {
                return this.isOpen ? 'true' : 'false';
            },
            get hasSession() {
                return this.token !== '' && this.sessionStatus === 'active';
            },
            get needsIntro() {
                return this.token === '';
            },
            get hasNoMessages() {
                return this.messages.length === 0;
            },
            get hasBanner() {
                return this.availabilityMessage !== '';
            },
            get bannerText() {
                return this.availabilityMessage;
            },
            get bannerClass() {
                return BANNER_CLASS[this.availability] || BANNER_CLASS.offline;
            },
            get hasNotice() {
                return this.notice !== '';
            },
            get hasUnread() {
                return this.unreadCount > 0;
            },
            get unreadAnnouncement() {
                return this.unreadCount > 0 ? t('unread').replace('%1', String(this.unreadCount)) : '';
            },
            get bubbleLabel() {
                return this.unreadCount > 0 ? t('open') + ' (' + this.unreadAnnouncement + ')' : t('open');
            },
            get sendDisabled() {
                return this.draft.trim() === '';
            },
            get logBusy() {
                return this.historyLoading ? 'true' : 'false';
            },

            toggle() {
                if (this.isOpen) {
                    this.close();
                } else {
                    this.open();
                }
            },

            open() {
                this.isOpen = true;
                this.unreadCount = 0;
                this.wake();
                if (!this.booted) {
                    this.booted = true;
                    this.boot();
                } else {
                    this.syncRealtime();
                }
                var self = this;
                this.$nextTick(function () {
                    if (self.$refs.input) {
                        self.$refs.input.focus();
                    }
                    self.scrollLog();
                });
            },

            close() {
                this.isOpen = false;
                this.syncRealtime();
                var self = this;
                this.$nextTick(function () {
                    if (self.$refs.bubble) {
                        self.$refs.bubble.focus();
                    }
                });
            },

            onNameInput(event) {
                this.displayName = event.target.value;
            },
            onEmailInput(event) {
                this.email = event.target.value;
            },
            onDraftInput(event) {
                this.draft = event.target.value;
            },
            onEnter(event) {
                if (event.shiftKey || event.isComposing) {
                    return;
                }
                event.preventDefault();
                this.send();
            },

            boot() {
                var stored = readStored(rt.storageKey);
                if (stored === '') {
                    this.fetchAvailability();
                    return;
                }
                this.token = stored;
                this.resume(stored);
            },

            resume(token) {
                var self = this;
                return request('POST', rt.restRoot + 'session/status', { sessionToken: token }).then(function (res) {
                    if (self.token !== token) {
                        return null;
                    }
                    if (res.ok && res.data && res.data.status === 'active') {
                        self.adoptSession(res.data);
                        if (rt.historyToken === token) {
                            self.syncRealtime();
                            return null;
                        }
                        return self.catchUp(token);
                    }
                    if (res.ok || isGone(res)) {
                        self.dropSession();
                        self.fetchAvailability();
                        return null;
                    }
                    self.booted = false;
                    self.notice = refusalText(res, rt.i18n);
                    return null;
                });
            },

            catchUp(token) {
                var self = this;
                rt.historyToken = token;
                this.historyLoading = true;
                return this.loadHistory(token).then(function () {
                    self.historyLoading = false;
                    self.syncRealtime();
                }, function () {
                    self.historyLoading = false;
                });
            },

            fetchAvailability() {
                var self = this;
                request('GET', rt.restRoot + 'availability/0', null).then(function (res) {
                    if (res.ok && res.data) {
                        self.availability = text(res.data.status);
                        self.availabilityMessage = text(res.data.message);
                    }
                });
            },

            adoptSession(data) {
                this.token = text(data.session_token) || this.token;
                this.sessionStatus = text(data.status);
                this.availability = text(data.availability);
                this.availabilityMessage = text(data.availability_message);
                writeStored(rt.storageKey, this.token);
            },

            dropSession() {
                this.stopRealtime();
                forgetStored(rt.storageKey, this.token);
                this.token = '';
                this.sessionStatus = '';
                rt.historyToken = '';
                rt.pollCount = 0;
                rt.unsettled = {};
                rt.streamEnd = '';
                rt.wasIdle = false;
            },

            accepted(token) {
                if (token === '' || this.token !== token) {
                    return;
                }
                this.booted = true;
                this.sessionStatus = 'active';
                rt.streamEnd = '';
                rt.wasIdle = false;
                if (rt.historyToken !== token) {
                    this.catchUp(token);
                } else {
                    this.syncRealtime();
                }
            },

            ensureSession() {
                if (this.token !== '') {
                    return Promise.resolve(this.token);
                }
                if (rt.starting) {
                    return rt.starting;
                }
                var self = this;
                var payload = {};
                ['productId', 'categoryId', 'cmsPageId'].forEach(function (key) {
                    if (toInt(rt.config[key]) > 0) {
                        payload[key] = toInt(rt.config[key]);
                    }
                });
                if (this.displayName.trim() !== '') {
                    payload.displayName = this.displayName.trim();
                }
                if (this.email.trim() !== '') {
                    payload.email = this.email.trim();
                }
                payload.originUrl = pageUrl();
                rt.starting = request('POST', rt.restRoot + 'session', payload).then(function (res) {
                    rt.starting = null;
                    if (!res.ok || !res.data || !TOKEN_PATTERN.test(text(res.data.session_token))) {
                        return Promise.reject(res);
                    }
                    self.adoptSession(res.data);
                    rt.historyToken = self.token;
                    self.syncRealtime();
                    return self.token;
                });
                return rt.starting;
            },

            loadHistory(token) {
                var self = this;
                var page = 0;
                function next() {
                    page += 1;
                    return request('POST', rt.restRoot + 'messages', {
                        sessionToken: token,
                        afterId: rt.lastId,
                        limit: HISTORY_PAGE
                    }).then(function (res) {
                        if (self.token !== token) {
                            return null;
                        }
                        if (!res.ok || !res.data) {
                            if (isGone(res)) {
                                self.conversationEnded();
                            }
                            return null;
                        }
                        var items = res.data.items || [];
                        items.forEach(function (item) {
                            self.receive(item);
                        });
                        if (items.length === HISTORY_PAGE && page < HISTORY_MAX_PAGES) {
                            return next();
                        }
                        return null;
                    });
                }
                return next();
            },

            byKey(key) {
                for (var i = 0; i < this.messages.length; i++) {
                    if (this.messages[i].key === key) {
                        return this.messages[i];
                    }
                }
                return null;
            },

            removeKey(key) {
                this.messages = this.messages.filter(function (m) {
                    return m.key !== key;
                });
            },

            decorate(msg) {
                var dir = ROW_CLASS[msg.direction] ? msg.direction : 'system';
                msg.rowClass = ROW_CLASS[dir];
                msg.bubbleClass = BUBBLE_CLASS[dir];
                var undelivered = msg.direction === 'outbound' && msg.deliveryStatus === 'failed';
                var givenUp = undelivered && !msg.retrying;
                msg.isFailed = msg.state === 'failed' || givenUp;
                msg.canRetry = (msg.state === 'failed' && !msg.noRetry)
                    || (givenUp && !msg.resent && msg.body !== '' && msg.attachmentUrl === '');
                msg.canDownload = isAllowedAttachmentUrl(msg.attachmentUrl, rt.origins);
                msg.hasAttachment = msg.attachmentName !== '' || msg.canDownload;
                msg.isPendingFile = msg.hasAttachment && !msg.canDownload;
                msg.attachmentLabel = msg.canDownload
                    ? t('download') + ': ' + (msg.attachmentName || t('download'))
                    : msg.attachmentName;
                msg.hasBody = msg.body !== '';
                if (msg.state === 'sending') {
                    msg.statusLabel = t('sending');
                } else if (msg.state === 'failed') {
                    msg.statusLabel = t('notSent') + (msg.failReason !== '' ? ': ' + msg.failReason : '');
                } else if (givenUp) {
                    msg.statusLabel = t('notDelivered');
                } else if (undelivered) {
                    msg.statusLabel = t('notDeliveredRetrying');
                } else if (msg.direction === 'outbound' && msg.deliveryStatus === 'pending') {
                    msg.statusLabel = t('deliveryPending');
                } else {
                    msg.statusLabel = '';
                }
                msg.hasStatus = msg.statusLabel !== '';
                msg.statusClass = msg.isFailed ? STATUS_FAILED_CLASS : STATUS_QUIET_CLASS;
                return msg;
            },

            local(kind, body, name) {
                rt.seq += 1;
                return this.decorate({
                    key: 'l' + rt.seq,
                    id: 0,
                    kind: kind,
                    direction: 'outbound',
                    authorLabel: t('you'),
                    body: body,
                    attachmentUrl: '',
                    attachmentName: name,
                    deliveryStatus: '',
                    retrying: false,
                    state: 'sending',
                    failReason: '',
                    resent: false,
                    goneRetried: false,
                    noRetry: false,
                    retryWaiting: false
                });
            },

            apply(msg, raw) {
                var dir = text(raw.direction);
                var settled = msg.id > 0 && msg.id === toInt(raw.id) && msg.deliveryStatus === 'delivered';
                msg.id = toInt(raw.id);
                msg.direction = ROW_CLASS[dir] ? dir : 'system';
                if (msg.direction === 'outbound') {
                    msg.authorLabel = t('you');
                } else if (msg.direction === 'inbound') {
                    msg.authorLabel = text(raw.author_name) || t('agent');
                } else {
                    msg.authorLabel = t('system');
                }
                msg.body = text(raw.body);
                msg.attachmentUrl = text(raw.attachment_url);
                msg.attachmentName = text(raw.attachment_name);
                if (!settled) {
                    msg.deliveryStatus = text(raw.delivery_status);
                    msg.retrying = raw.retrying !== false;
                }
                msg.state = 'sent';
                msg.failReason = '';
                this.decorate(msg);
                this.track(msg, raw);
                this.scheduleSettle();
            },

            track(msg, raw) {
                var open = msg.direction === 'outbound'
                    && (msg.deliveryStatus === 'pending' || (msg.deliveryStatus === 'failed' && msg.retrying));
                if (!open || msg.id <= 0) {
                    delete rt.unsettled[msg.id];
                    return;
                }
                if (rt.unsettled[msg.id]) {
                    return;
                }
                var since = Date.now();
                var created = Date.parse(text(raw.created_at));
                if (!isNaN(created) && created < since) {
                    since = created;
                }
                rt.unsettled[msg.id] = since;
            },

            unsettledIds() {
                var now = Date.now();
                return Object.keys(rt.unsettled).filter(function (id) {
                    if (now - rt.unsettled[id] > SETTLE_WINDOW_MS) {
                        delete rt.unsettled[id];
                        return false;
                    }
                    return true;
                }).map(Number);
            },

            scheduleSettle() {
                if (rt.settleTimer !== null || !this.isOpen || !this.hasSession || document.hidden
                    || this.unsettledIds().length === 0) {
                    return;
                }
                var self = this;
                rt.settleTimer = window.setTimeout(function () {
                    rt.settleTimer = null;
                    self.settle();
                }, SETTLE_INTERVAL_MS);
            },

            stopSettle() {
                if (rt.settleTimer !== null) {
                    window.clearTimeout(rt.settleTimer);
                    rt.settleTimer = null;
                }
            },

            settle() {
                var self = this;
                var token = this.token;
                var ids = this.unsettledIds();
                if (token === '' || ids.length === 0 || !this.isOpen || document.hidden) {
                    return;
                }
                request('POST', rt.restRoot + 'messages', {
                    sessionToken: token,
                    afterId: Math.min.apply(Math, ids) - 1,
                    limit: 100
                }).then(function (res) {
                    if (self.token !== token) {
                        return;
                    }
                    if (!res.ok || !res.data) {
                        if (isGone(res)) {
                            self.conversationEnded();
                            return;
                        }
                    } else {
                        (res.data.items || []).forEach(function (item) {
                            self.receive(item);
                        });
                    }
                    self.scheduleSettle();
                });
            },

            receive(raw) {
                var id = raw ? toInt(raw.id) : 0;
                if (id <= 0) {
                    return;
                }
                if (id > rt.lastId) {
                    rt.lastId = id;
                }
                var knownKey = rt.seen[id];
                if (knownKey) {
                    var known = this.byKey(knownKey);
                    if (known) {
                        this.apply(known, raw);
                    }
                    return;
                }
                if (text(raw.direction) === 'outbound') {
                    var pending = this.pendingMatch(raw);
                    if (pending) {
                        this.apply(pending, raw);
                        rt.seen[id] = pending.key;
                        return;
                    }
                }
                rt.seq += 1;
                this.messages.push(this.decorate({
                    key: 'm' + id,
                    id: id,
                    kind: 'text',
                    direction: 'system',
                    authorLabel: '',
                    body: '',
                    attachmentUrl: '',
                    attachmentName: '',
                    deliveryStatus: '',
                    retrying: false,
                    state: 'sent',
                    failReason: '',
                    resent: false,
                    goneRetried: false,
                    noRetry: false,
                    retryWaiting: false
                }));
                this.apply(this.byKey('m' + id), raw);
                rt.seen[id] = 'm' + id;
                if (!this.isOpen && text(raw.direction) !== 'outbound') {
                    this.unreadCount += 1;
                }
                this.scrollLog();
            },

            pendingMatch(raw) {
                var body = text(raw.body);
                var name = text(raw.attachment_name);
                for (var i = 0; i < this.messages.length; i++) {
                    var m = this.messages[i];
                    if (m.id === 0 && m.state === 'sending'
                        && (m.kind === 'file' ? m.attachmentName === name : m.body === body)) {
                        return m;
                    }
                }
                return null;
            },

            confirm(key, data) {
                var id = data ? toInt(data.id) : 0;
                var msg = this.byKey(key);
                if (!msg) {
                    return;
                }
                delete rt.files[key];
                if (id > 0 && rt.seen[id] && rt.seen[id] !== key) {
                    this.removeKey(key);
                    var known = this.byKey(rt.seen[id]);
                    if (known) {
                        this.apply(known, data);
                    }
                    return;
                }
                this.apply(msg, data || {});
                if (id > 0) {
                    rt.seen[id] = key;
                    if (id > rt.lastId) {
                        rt.lastId = id;
                    }
                }
            },

            fail(key, res) {
                var msg = this.byKey(key);
                if (!msg) {
                    return;
                }
                var wait = res.status === 429 || res.status === 503 ? res.retryAfter || 0 : 0;
                msg.state = 'failed';
                msg.failReason = refusalText(res, rt.i18n);
                msg.noRetry = FINAL_REFUSALS.indexOf(errorCode(res.data)) !== -1;
                msg.retryWaiting = wait > 0;
                this.decorate(msg);
                if (wait > 0) {
                    var self = this;
                    window.setTimeout(function () {
                        var current = self.byKey(key);
                        if (current) {
                            current.retryWaiting = false;
                            self.decorate(current);
                        }
                    }, wait * 1000);
                }
            },

            send() {
                var body = this.draft.trim();
                if (body === '') {
                    return;
                }
                this.draft = '';
                this.notice = '';
                var msg = this.local('text', body, '');
                this.messages.push(msg);
                this.enqueue(msg.key);
                this.scrollLog();
                this.focusInput();
            },

            focusInput() {
                var self = this;
                this.$nextTick(function () {
                    if (self.isOpen && self.$refs.input) {
                        self.$refs.input.focus();
                    }
                });
            },

            onFileChosen(event) {
                var input = event.target;
                var file = input.files && input.files.length > 0 ? input.files[0] : null;
                input.value = '';
                if (!file) {
                    return;
                }
                this.notice = '';
                if (!this.uploadsEnabled) {
                    this.notice = t('uploadsOff');
                    return;
                }
                if (file.size === 0) {
                    this.notice = t('fileEmpty');
                    return;
                }
                if (file.size > toInt(rt.config.maxUploadBytes)) {
                    this.notice = t('tooLarge');
                    return;
                }
                var allowed = rt.config.allowedMimeTypes || [];
                if (allowed.length > 0 && allowed.indexOf(text(file.type).toLowerCase()) === -1) {
                    this.notice = t('typeNotAllowed');
                    return;
                }
                var msg = this.local('file', '', text(file.name));
                rt.files[msg.key] = { file: file, content: null };
                this.messages.push(msg);
                this.enqueue(msg.key);
                this.scrollLog();
            },

            retry() {
                var msg = this.byKey(this.message.key);
                if (!msg || !msg.canRetry || msg.retryWaiting) {
                    return;
                }
                this.focusInput();
                if (msg.state !== 'failed') {
                    msg.resent = true;
                    this.decorate(msg);
                    var copy = this.local('text', msg.body, '');
                    this.messages.push(copy);
                    this.enqueue(copy.key);
                    this.scrollLog();
                    return;
                }
                msg.goneRetried = false;
                msg.noRetry = false;
                msg.state = 'sending';
                msg.failReason = '';
                this.decorate(msg);
                this.enqueue(msg.key);
            },

            enqueue(key) {
                var self = this;
                rt.chain = rt.chain.then(function () {
                    return self.deliver(key, false);
                }).catch(function () {
                    self.fail(key, { ok: false, status: 0, data: null, retryAfter: 0 });
                });
            },

            note(body) {
                rt.seq += 1;
                return this.decorate({
                    key: 'n' + rt.seq,
                    id: 0,
                    kind: 'text',
                    direction: 'system',
                    authorLabel: t('system'),
                    body: body,
                    attachmentUrl: '',
                    attachmentName: '',
                    deliveryStatus: '',
                    retrying: false,
                    state: 'sent',
                    failReason: '',
                    resent: false,
                    goneRetried: false,
                    noRetry: false,
                    retryWaiting: false
                });
            },

            noteBefore(key, body) {
                var at = -1;
                for (var i = 0; i < this.messages.length; i++) {
                    if (this.messages[i].key === key) {
                        at = i;
                    }
                }
                if (at === -1) {
                    this.messages.push(this.note(body));
                } else {
                    this.messages.splice(at, 0, this.note(body));
                }
            },

            deliver(key, afterGone) {
                var self = this;
                var used = '';
                if (!this.byKey(key)) {
                    return Promise.resolve();
                }
                return this.ensureSession().then(function (token) {
                    used = token;
                    if (afterGone) {
                        self.noteBefore(key, t('newConversation'));
                    }
                    return self.post(key, token);
                }, function (res) {
                    return res && typeof res.status === 'number' ? res : { ok: false, status: 0, data: null, retryAfter: 0 };
                }).then(function (res) {
                    var current = self.byKey(key);
                    if (!current) {
                        return null;
                    }
                    if (res.ok) {
                        self.confirm(key, res.data);
                        self.accepted(used);
                        return null;
                    }
                    if (isGone(res)) {
                        if (used !== '' && self.token === used) {
                            self.dropSession();
                        }
                        if (!current.goneRetried) {
                            current.goneRetried = true;
                            return self.deliver(key, true);
                        }
                    }
                    self.fail(key, res);
                    return null;
                });
            },

            post(key, token) {
                var msg = this.byKey(key);
                var root = rt.restRoot;
                if (msg.kind !== 'file') {
                    return request('POST', root + 'message', { sessionToken: token, body: msg.body });
                }
                var entry = rt.files[key];
                if (!entry) {
                    return Promise.resolve({ ok: false, status: 0, data: null });
                }
                var ready = entry.content !== null ? Promise.resolve(entry.content) : readAsBase64(entry.file);
                return ready.then(function (content) {
                    entry.content = content;
                    return request('POST', root + 'upload', {
                        sessionToken: token,
                        filename: text(entry.file.name),
                        mimeType: text(entry.file.type).toLowerCase() || 'application/octet-stream',
                        content: content
                    });
                }, function () {
                    return { ok: false, status: 0, data: null, retryAfter: 0 };
                });
            },

            openAttachment() {
                var msg = this.byKey(this.message.key);
                var self = this;
                var token = this.token;
                if (!msg || token === '' || !isAllowedAttachmentUrl(msg.attachmentUrl, rt.origins)) {
                    return;
                }
                var name = msg.attachmentName || 'attachment';
                window.fetch(msg.attachmentUrl, {
                    credentials: 'same-origin',
                    headers: { 'X-Bfslc-Token': token }
                }).then(function (response) {
                    return response.ok ? response.blob() : Promise.reject(response);
                }).then(function (blob) {
                    if (self.token !== token) {
                        return;
                    }
                    var url = URL.createObjectURL(blob);
                    rt.blobUrls.push(url);
                    var link = document.createElement('a');
                    link.href = url;
                    link.download = name;
                    link.rel = 'noopener';
                    document.body.appendChild(link);
                    link.click();
                    link.remove();
                }).catch(function () {
                    if (self.token === token) {
                        self.notice = t('genericError');
                    }
                });
            },

            endChat() {
                var self = this;
                var token = this.token;
                if (token === '') {
                    return;
                }
                this.notice = '';
                request('POST', rt.restRoot + 'session/close', { sessionToken: token }).then(function (res) {
                    if (self.token !== token) {
                        return;
                    }
                    if (res.ok || isGone(res)) {
                        self.conversationEnded();
                        self.focusInput();
                        return;
                    }
                    self.notice = refusalText(res, rt.i18n);
                });
            },

            conversationEnded() {
                this.dropSession();
                this.messages.push(this.note(t('ended')));
                this.scrollLog();
            },

            syncRealtime() {
                if (!this.hasSession || document.hidden) {
                    this.stopRealtime();
                    return;
                }
                if (!this.isOpen) {
                    this.stopStream();
                    this.clearStreamRetry();
                    this.stopSettle();
                    this.startPolling(SLOW_POLL_MS);
                    return;
                }
                this.scheduleSettle();
                if (rt.streamEnd === 'idle') {
                    this.stopStream();
                    this.clearStreamRetry();
                    this.startPolling(IDLE_POLL_MS);
                    return;
                }
                if (rt.streamEnd === 'superseded') {
                    this.stopStream();
                    this.clearStreamRetry();
                    this.startPolling(SLOW_POLL_MS);
                    return;
                }
                if (rt.es !== null || (rt.pollTimer !== null && rt.pollMs === POLL_MS)) {
                    return;
                }
                this.stopPolling();
                this.connectStream();
            },

            connectStream() {
                if (typeof window.EventSource !== 'function') {
                    this.startPolling(POLL_MS);
                    return;
                }
                var self = this;
                var token = this.token;
                var base = text(rt.config.streamUrl);
                var url = base + (base.indexOf('?') === -1 ? '?' : '&')
                    + 'token=' + encodeURIComponent(token) + '&after=' + rt.lastId;
                var source = new window.EventSource(url);
                var openedAt = 0;
                rt.es = source;
                function current() {
                    return rt.es === source && self.token === token;
                }
                source.addEventListener('open', function () {
                    if (current()) {
                        openedAt = Date.now();
                        rt.wasIdle = false;
                    }
                });
                source.addEventListener('message', function (event) {
                    if (!current()) {
                        return;
                    }
                    var data = null;
                    try {
                        data = JSON.parse(event.data);
                    } catch (e) {
                        data = null;
                    }
                    if (data) {
                        self.receive(data);
                    }
                });
                source.addEventListener('closed', function () {
                    if (current()) {
                        self.conversationEnded();
                    }
                });
                ['idle', 'superseded'].forEach(function (ending) {
                    source.addEventListener(ending, function () {
                        if (current()) {
                            rt.streamEnd = ending;
                            self.stopStream();
                            self.syncRealtime();
                        }
                    });
                });
                source.addEventListener('reconnecting', function () {
                    if (!current()) {
                        return;
                    }
                    self.stopStream();
                    if (openedAt > 0 && Date.now() - openedAt >= STREAM_HEALTHY_MS) {
                        self.syncRealtime();
                        return;
                    }
                    self.startPolling(POLL_MS);
                    self.scheduleStreamRetry();
                });
                source.onerror = function () {
                    if (!current() || source.readyState !== window.EventSource.CLOSED) {
                        return;
                    }
                    self.stopStream();
                    if (openedAt === 0 && rt.wasIdle) {
                        rt.streamEnd = 'idle';
                        self.syncRealtime();
                        return;
                    }
                    self.startPolling(POLL_MS);
                    self.scheduleStreamRetry();
                };
            },

            stopStream() {
                if (rt.es !== null) {
                    rt.es.close();
                    rt.es = null;
                }
            },

            startPolling(ms) {
                if (this.token === '') {
                    return;
                }
                if (rt.pollTimer !== null) {
                    if (rt.pollMs === ms) {
                        return;
                    }
                    this.stopPolling();
                }
                var self = this;
                rt.pollMs = ms;
                rt.pollTimer = window.setInterval(function () {
                    self.poll();
                }, ms);
                this.poll();
            },

            stopPolling() {
                if (rt.pollTimer !== null) {
                    window.clearInterval(rt.pollTimer);
                    rt.pollTimer = null;
                    rt.pollMs = 0;
                }
            },

            poll() {
                var self = this;
                var token = this.token;
                var before = rt.lastId;
                if (rt.pollBusy || token === '') {
                    return;
                }
                rt.pollBusy = true;
                request('POST', rt.restRoot + 'messages', {
                    sessionToken: token,
                    afterId: rt.lastId,
                    limit: 100
                }).then(function (res) {
                    if (self.token !== token) {
                        return null;
                    }
                    if (!res.ok || !res.data) {
                        if (isGone(res)) {
                            self.conversationEnded();
                        }
                        return null;
                    }
                    (res.data.items || []).forEach(function (item) {
                        self.receive(item);
                    });
                    if (rt.streamEnd === 'idle' && rt.lastId > before && self.isOpen && !document.hidden) {
                        rt.streamEnd = '';
                        rt.wasIdle = false;
                        self.stopPolling();
                        self.syncRealtime();
                    }
                    rt.pollCount += 1;
                    return rt.pollCount % STATUS_EVERY_N_POLLS === 0 ? self.checkStatus(token) : null;
                }).then(function () {
                    rt.pollBusy = false;
                }, function () {
                    rt.pollBusy = false;
                });
            },

            checkStatus(token) {
                var self = this;
                return request('POST', rt.restRoot + 'session/status', { sessionToken: token }).then(function (res) {
                    if (self.token !== token) {
                        return;
                    }
                    if (isGone(res) || (res.ok && res.data && res.data.status !== 'active')) {
                        self.conversationEnded();
                    } else if (res.ok && res.data) {
                        self.adoptSession(res.data);
                    }
                });
            },

            scheduleStreamRetry() {
                var self = this;
                if (rt.retryTimer !== null) {
                    return;
                }
                rt.retryTimer = window.setTimeout(function () {
                    rt.retryTimer = null;
                    self.stopPolling();
                    self.syncRealtime();
                }, STREAM_RETRY_MS);
            },

            clearStreamRetry() {
                if (rt.retryTimer !== null) {
                    window.clearTimeout(rt.retryTimer);
                    rt.retryTimer = null;
                }
            },

            wake() {
                if (rt.streamEnd === 'idle') {
                    rt.streamEnd = '';
                    rt.wasIdle = true;
                }
            },

            stopRealtime() {
                this.stopStream();
                this.stopPolling();
                this.clearStreamRetry();
                this.stopSettle();
            },

            scrollLog() {
                var self = this;
                this.$nextTick(function () {
                    var log = self.$refs.log;
                    if (log) {
                        log.scrollTop = log.scrollHeight;
                    }
                });
            }
        };
    }

    function register() {
        window.Alpine.data('bfslcChat', bfslcChat);
    }

    if (window.Alpine && typeof window.Alpine.data === 'function') {
        register();
    }
    document.addEventListener('alpine:init', register, { once: true });
})();</script>
